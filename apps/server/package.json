{
  "name": "server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "imports": {
    "#entities/*": "./src/entities/*/index.ts",
    "#features/*": "./src/features/*/index.ts",
    "#shared/*": "./src/shared/*/index.ts"
  },
  "exports": {
    ".": "./src/app/main.ts",
    "./embedder-worker": "./src/app/embedder-worker.ts"
  },
  "scripts": {
    "bundle": "vp pack",
    "fetch-model": "node src/app/fetch-model.ts",
    "test": "vp test run",
    "steiger": "steiger ./src",
    "fallow": "fallow --skip dupes --fail-on-issues --quiet --format compact && fallow dupes --fail-on-issues --quiet --format compact && fallow security --fail-on-issues --quiet"
  },
  "dependencies": {
    "@effect/platform-node": "catalog:",
    "@effect/sql-sqlite-node": "catalog:",
    "@huggingface/transformers": "catalog:stack",
    "@zip.js/zip.js": "catalog:",
    "effect": "catalog:stack",
    "modern-tar": "catalog:",
    "protocol": "workspace:*",
    "runtime": "workspace:*",
    "sqlite-vec": "catalog:"
  },
  "devDependencies": {
    "@effect/vitest": "catalog:",
    "@feature-sliced/steiger-plugin": "0.8.2",
    "@types/node": "catalog:",
    "steiger": "catalog:stack",
    "typescript": "catalog:",
    "vite-plus": "catalog:stack"
  }
}
