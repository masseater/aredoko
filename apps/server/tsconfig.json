{
  "$schema": "./node_modules/@effect/tsgo/schema.json",
  "extends": "../../tsconfig.base.json",
  "include": ["src", "*.ts"],
  "compilerOptions": {
    "paths": {
      "#entities/*": ["./src/entities/*/index.ts"],
      "#features/*": ["./src/features/*/index.ts"],
      "#shared/*": ["./src/shared/*/index.ts"]
    },
    "plugins": [
      {
        "name": "@effect/language-service",
        "allowedUnstableApis": [
          "@effect/platform-node-shared/NodeSocketServer#layerWebSocket",
          "@effect/platform-node/NodeServices#layer",
          "@effect/platform-node/NodeWorker#layer",
          "@effect/platform-node/NodeWorkerRunner#layer",
          "@effect/sql-sqlite-node/SqliteClient",
          "@effect/sql-sqlite-node/SqliteMigrator",
          "@effect/vitest#it",
          "@effect/vitest#layer",
          "effect/FileSystem#FileSystem",
          "effect/Path#Path",
          "effect/cli/Command#make",
          "effect/cli/Command#run",
          "effect/cli/Flag#String",
          "effect/cli/Flag#optional",
          "effect/http/FetchHttpClient#layer",
          "effect/http/HttpClient",
          "effect/http/HttpClientResponse",
          "effect/net/NetAddress#SocketAddress",
          "effect/rpc/RpcClient",
          "effect/rpc/RpcClientError",
          "effect/rpc/RpcGroup",
          "effect/rpc/Rpc",
          "effect/rpc/RpcSerialization",
          "effect/rpc/RpcServer",
          "effect/rpc/RpcWorker",
          "effect/socket/SocketServer#SocketServer",
          "effect/sql/Migrator",
          "effect/sql/SqlClient"
        ]
      }
    ]
  }
}
