{
  "$schema": "./node_modules/@effect/tsgo/schema.json",
  "extends": "../../tsconfig.base.json",
  "include": ["src", "*.ts"],
  "compilerOptions": {
    "paths": {
      "#shared/*": ["./src/shared/*/index.ts"]
    },
    "plugins": [
      {
        "name": "@effect/language-service",
        "allowedUnstableApis": [
          "@effect/platform-node-shared/NodeSocketServer#layerWebSocket",
          "@effect/platform-node/NodeRuntime#runMain",
          "effect/http/FetchHttpClient#layer",
          "effect/observability/OtlpSerialization#layerJson",
          "effect/observability/OtlpTracer#layerFromConfig",
          "effect/rpc/Rpc",
          "effect/rpc/RpcGroup",
          "effect/rpc/RpcSerialization",
          "effect/rpc/RpcServer"
        ]
      }
    ]
  }
}
